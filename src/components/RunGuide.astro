---
import type { Run } from '../data/project-schema';
interface Props { runs: Run[] }
const { runs } = Astro.props;
---
{runs.map(run => <section class="run-guide">
  <h4>{run.label}</h4><p class="requirements">{run.requirements}</p>
  <div class="code-block"><pre><code>{run.commands.trim()}</code></pre><div class="copy-row"><button type="button" data-copy hidden aria-label={`Copy commands: ${run.label}`}>Copy commands</button><span data-copy-status role="status"></span></div></div>
  <p class="note">{run.note}</p>
</section>)}
