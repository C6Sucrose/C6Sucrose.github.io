---
import type { InterestId } from '../data/interests';
interface Props { id: InterestId }
const { id } = Astro.props;
---
{id === 'games' && <svg viewBox="0 0 300 192" fill="none" stroke="var(--hull-line)" stroke-width="1.5" aria-hidden="true">
  <path d="M24 17h247v142l-29 17H47l-23-23Z" fill="var(--hull)" opacity=".18" transform="translate(6 8)" stroke="none" />
  <path d="M72 150h158l20 28H53Z" fill="var(--hull-line)" /><path d="M66 173h170" stroke="var(--bone)" />
  <rect x="24" y="17" width="247" height="87" rx="7" fill="var(--hull-raised)" stroke="var(--bleed)" />
  <path d="M31 22h232" stroke="var(--bone)" />
  <rect class="games-screen" x="42" y="29" width="211" height="61" fill="var(--hull)" stroke="var(--bone-dim)" />
  <path d="m80 69 32-25 32 25 32-25 32 25" stroke="var(--core)" stroke-width="3" />
  <path class="games-scan" data-motion d="M45 37h204" stroke="var(--bone)" opacity=".5" />
  <rect class="games-cursor" data-motion x="229" y="72" width="12" height="4" fill="var(--bone)" />
  <path d="M24 110 46 102h205l20 8v48H24Z" fill="var(--hull-raised)" stroke="var(--bleed)" />
  <path d="M31 111h232" stroke="var(--bone)" />
  <rect x="84" y="116" width="119" height="30" fill="var(--hull)" stroke="var(--bone-dim)" />
  <path d="M93 135h13m6-6h14m6 6h14m6-6h14m6 6h17" stroke="var(--trim)" />
  <g class="games-stick-track"><g class="games-stick" data-motion data-pose-probe>
    <circle cx="55" cy="132" r="17" fill="var(--hull)" stroke="var(--bone-dim)" /><path d="M55 132v-15" stroke="var(--bone)" stroke-width="5" /><circle cx="55" cy="116" r="8" fill="var(--bleed)" />
  </g></g>
  <g fill="var(--bone-dim)"><circle cx="233" cy="120" r="5" /><circle cx="245" cy="132" r="5" /><circle cx="221" cy="132" r="5" /><circle cx="233" cy="144" r="5" /></g>
  <path d="M13 111h11m247 0h13" stroke="var(--bone)" stroke-width="5" />
  <text x="146" y="163" text-anchor="middle" fill="var(--bone-dim)" stroke="none" font-family="monospace" font-size="8">PLAY / MODIFY / REPEAT</text>
</svg>}
{id === 'pc' && <svg viewBox="0 0 245 276" fill="none" stroke="var(--hull-line)" stroke-width="1.5" aria-hidden="true">
  <defs><radialGradient id="pc-aperture-glow"><stop stop-color="var(--core)" /><stop offset="1" stop-color="var(--hull)" /></radialGradient></defs>
  <path d="M25 49 183 23 215 52 219 243 57 258 25 222Z" fill="var(--hull)" opacity=".18" transform="translate(6 8)" stroke="none" />
  <path d="M25 49 183 23 215 52 57 79Z" fill="var(--bone-dim)" />
  <path d="M25 49 57 79 57 258 25 222Z" fill="var(--hull-line)" />
  <path d="M57 79 215 52 219 243 57 258Z" fill="var(--hull-raised)" />
  <path d="M31 48 183 29 207 52M62 82 207 58" stroke="var(--bone)" />
  <path d="M68 91 200 72 201 146 69 159Z" fill="var(--hull)" stroke="var(--trim)" />
  <g class="pc-iris-track"><g class="pc-iris" data-motion data-pose-probe>
    <ellipse cx="104" cy="117" rx="22" ry="16" fill="url(#pc-aperture-glow)" stroke="var(--core)" />
    <ellipse cx="170" cy="108" rx="22" ry="16" fill="url(#pc-aperture-glow)" stroke="var(--core)" />
    <path d="M91 117h26m-13-8v16m53-17h26m-13-8v16" stroke="var(--bone)" />
  </g></g>
  <g stroke="var(--bone-dim)"><path d="M31 78v133m7-124v127m7-116v123M73 163l120-13m-120 20 120-13m-120 20 120-13" /></g>
  <circle cx="97" cy="201" r="25" fill="var(--hull)" stroke="var(--trim)" />
  <circle cx="171" cy="192" r="25" fill="var(--hull)" stroke="var(--trim)" />
  <g class="pc-fan-a" data-motion fill="var(--bone-dim)"><path d="M97 201c-24-23-27-2-7 4l7-4c-12 28 9 27 10 6l-10-6c29-3 19-22 0-11Z" /></g>
  <g class="pc-fan-b" data-motion fill="var(--bone-dim)"><path d="M171 192c-24-23-27-2-7 4l7-4c-12 28 9 27 10 6l-10-6c29-3 19-22 0-11Z" /></g>
  <path d="M78 238h96" stroke="var(--trim)" /><rect class="pc-led" data-motion x="188" y="225" width="8" height="4" fill="var(--core)" />
  <path class="pc-heat" data-motion d="M113 55q-9-10 0-20m13 18q-9-10 0-20" stroke="var(--hull-line)" stroke-width="2" opacity=".5" />
  <text x="131" y="254" text-anchor="middle" fill="var(--bone-dim)" stroke="none" font-family="monospace" font-size="8">BUILD / REPAIR</text>
</svg>}
{id === 'sky' && <svg viewBox="0 0 325 300" fill="none" stroke="var(--hull-line)" stroke-width="1.5" aria-hidden="true">
  <defs>
    <clipPath id="sky-window"><circle cx="155" cy="128" r="88" /></clipPath>
    <radialGradient id="sky-star-glow"><stop stop-color="var(--bone)" /><stop offset="1" stop-color="var(--hull)" /></radialGradient>
  </defs>
  <path d="M44 21h222v216H44Z" fill="var(--hull)" opacity=".18" transform="translate(6 8)" stroke="none" />
  <path d="M44 21h222v216H44Z" fill="var(--hull-raised)" stroke="var(--bleed)" />
  <path d="M49 26h210M49 26v203" stroke="var(--bone)" />
  <circle cx="155" cy="128" r="101" fill="var(--hull)" stroke="var(--bone-dim)" />
  <g clip-path="url(#sky-window)"><g class="sky-field">
    <circle cx="155" cy="128" r="88" fill="var(--hull)" />
    <circle cx="189" cy="85" r="12" fill="url(#sky-star-glow)" stroke="none" />
    {[[104,89],[145,62],[190,84],[210,137],[155,178],[101,159]].map(([cx,cy],i) => <circle class="sky-star" data-motion style={`--star:${i}`} cx={cx} cy={cy} r={i === 2 ? 3 : 2} fill="var(--bone)" stroke="none" />)}
    <path d="m104 89 41-27 45 22 20 53-55 41-54-19" stroke="var(--hull-line)" />
    <g class="sky-satellite" data-motion stroke="var(--bone-dim)"><path d="M77 51h7m-3-4v8" /><rect x="69" y="48" width="6" height="6" /><rect x="86" y="48" width="6" height="6" /></g>
  </g></g>
  <g class="sky-iris" data-motion data-pose-probe>
    {[0,60,120,180,240,300].map(angle => <path transform={`rotate(${angle} 155 128)`} d="M155 30a98 98 0 0 1 85 49L220.818 90A76 76 0 0 0 155 52Z" fill="var(--hull-line)" stroke="var(--bone-dim)" />)}
  </g>
  <circle cx="155" cy="128" r="99" stroke="var(--bleed)" />
  <g class="sky-scope"><path d="M222 206v56h55m-42-53h47v16h-47Z" fill="var(--hull-raised)" stroke="var(--bone-dim)" /><path d="M241 211h34" stroke="var(--bone)" /><circle cx="282" cy="217" r="10" fill="var(--hull)" stroke="var(--core)" /></g>
  <text x="149" y="256" text-anchor="middle" fill="var(--bone-dim)" stroke="none" font-family="monospace" font-size="9">OBSERVATORY / LOOK UP</text>
  <path d="M49 274h170m-162-5v10m154-10v10" stroke="var(--bleed)" />
</svg>}
{id === 'nature' && <svg viewBox="0 0 220 269" fill="none" stroke="var(--hull-line)" stroke-width="1.5" aria-hidden="true">
  <path d="M50 139h110v94q-55 28-110 0Z" fill="var(--hull)" opacity=".18" transform="translate(6 8)" stroke="none" />
  <path d="M51 142v91q54 25 108 0v-91" fill="var(--bone)" fill-opacity=".16" stroke="var(--bone-dim)" />
  <ellipse cx="105" cy="143" rx="56" ry="14" fill="var(--hull-raised)" stroke="var(--trim)" />
  <path d="M67 148v83m18-80v86m20-85v88m20-88v86m18-89v82M55 220q50 18 100 0" stroke="var(--bone-dim)" />
  <path d="M108 137v57m0-14-17 14m17-3 19 11m-19-1-11 20m11-17 13 21" stroke="var(--trim)" stroke-width="2" />
  <path d="M106 142c-5-30 0-70 2-105m-2 52L72 71m34 43 37-25" stroke="var(--trim)" stroke-width="3" />
  <g class="leaf-track"><g class="nature-leaf leaf-a" data-motion data-pose-probe>
    <path d="M108 66C78 53 85 21 109 13c27 14 27 42-1 53Z" fill="var(--trim)" /><path d="m109 26-1 35" stroke="var(--bone)" />
  </g></g>
  <g class="leaf-track"><g class="nature-leaf leaf-b" data-motion>
    <path d="M77 82C48 93 33 69 40 50c31-10 51 13 37 32Z" fill="var(--trim)" /><path d="m45 57 28 20" stroke="var(--bone)" />
  </g></g>
  <g class="leaf-track"><g class="nature-leaf leaf-c" data-motion>
    <path d="M140 98c-6-31 18-52 42-36 0 27-18 42-42 36Z" fill="var(--trim)" /><path d="m172 69-28 24" stroke="var(--bone)" />
  </g></g>
  <g class="leaf-track"><g class="nature-droop" data-motion>
    <path d="M99 128c-32 6-53-7-47-27 26-16 49 7 47 27Z" fill="var(--trim)" /><path d="m60 108 34 17" stroke="var(--bone)" />
  </g></g>
  <path class="nature-drop" data-motion d="M177 102q-7 10 0 12 7-2 0-12Z" fill="var(--bone)" stroke="none" />
  <rect id="pot-label-box" x="67" y="187" width="80" height="32" fill="var(--bone)" stroke="var(--ink-dim)" />
  <text id="pot-label" x="107" y="205" text-anchor="middle" font-family="Arial,sans-serif" font-weight="700" font-size="8" fill="var(--ink)" stroke="none">LIFE SUPPORT</text>
  <path d="M54 143q49 13 100 0M58 232q47 20 94 0" stroke="var(--bone)" />
</svg>}
{id === 'cooking' && <svg viewBox="0 0 290 165" fill="none" stroke="var(--hull-line)" stroke-width="1.5" aria-hidden="true">
  <path d="M53 61h180v50q-9 32-90 32-81 0-90-32Z" fill="var(--hull)" opacity=".18" transform="translate(6 8)" stroke="none" />
  <path d="M53 61h180v50q-9 32-90 32-81 0-90-32Z" fill="var(--hull-raised)" stroke="var(--peach)" />
  <path d="M53 75H28v23h27m178-23h26v23h-26" stroke="var(--bone-dim)" stroke-width="6" />
  <ellipse cx="143" cy="64" rx="91" ry="20" fill="var(--hull-line)" stroke="var(--peach)" />
  <path d="M70 52q70-21 145 0" stroke="var(--bone)" />
  <path d="M122 45V32h42v13" stroke="var(--bone-dim)" stroke-width="8" />
  <path d="M85 48V36m114 12V36" stroke="var(--bone-dim)" stroke-width="5" />
  <ellipse cx="143" cy="92" rx="53" ry="19" fill="var(--peach)" stroke="var(--bone-dim)" />
  <g class="broth" data-motion data-pose-probe>
    <ellipse cx="143" cy="92" rx="39" ry="10" stroke="var(--ink-dim)" />
    <path d="m111 89 16-3m16 9 13-4m14-2 11 4" stroke="var(--trim)" stroke-width="5" />
  </g>
  <g class="cooking-air" stroke="var(--bone-dim)" stroke-width="2">
    <path class="steam-a" data-motion pathLength="100" d="M86 37c-16-11 10-13-3-26" />
    <path class="steam-b" data-motion pathLength="100" d="M144 26c-14-8 9-12 0-21" />
    <path class="steam-c" data-motion pathLength="100" d="M199 38c14-12-10-14 3-28" />
  </g>
  <path d="m94 151 5-6 5 6m19 0 5-6 5 6m19 0 5-6 5 6m19 0 5-6 5 6" stroke="var(--peach)" />
  <rect class="cooking-lamp" data-motion x="135" y="136" width="15" height="4" fill="var(--core)" />
  <text x="143" y="127" text-anchor="middle" fill="var(--bone-dim)" stroke="none" font-family="monospace" font-size="8">KITCHEN / WORKING NOTES</text>
</svg>}
{id === 'ai' && <svg viewBox="0 0 277 160" fill="none" stroke="var(--hull-line)" stroke-width="1.5" aria-hidden="true">
  <path d="M27 26h224v118H27Z" fill="var(--hull)" opacity=".18" transform="translate(6 8)" stroke="none" />
  <path d="M27 26h224v118H27Z" fill="var(--hull-raised)" stroke="var(--bone-dim)" />
  <path d="M32 31h213M32 31v106" stroke="var(--bone)" />
  <path d="M42 125h74v10H42Z" fill="var(--hull-line)" stroke="var(--bone-dim)" />
  <g class="ai-reach"><g class="ai-arm" data-motion data-pose-probe>
    <path d="m66 120-12-28 58-49 18 18-54 39 9 20" fill="var(--bone-dim)" />
    <path d="m117 45 67 21-7 21-59-25Z" fill="var(--bone)" />
    <circle cx="70" cy="98" r="13" fill="var(--hull-line)" stroke="var(--bone-dim)" />
    <circle cx="119" cy="54" r="12" fill="var(--hull-line)" stroke="var(--bone)" />
    <path d="m173 63 24-5v34l-24-5Z" fill="var(--hull-line)" stroke="var(--bone-dim)" />
    <circle cx="213" cy="75" r="29" fill="var(--hull)" stroke="var(--bone)" />
    <g class="ai-focus" data-motion><circle cx="213" cy="75" r="23" stroke="var(--bone-dim)" stroke-dasharray="3 7" /><path d="M213 46v8m0 42v8m-29-29h8m42 0h8" stroke="var(--core)" /></g>
    <circle class="ai-pupil" cx="213" cy="75" r="8" fill="var(--core)" stroke="var(--bone)" />
    <path class="ai-scan" data-motion d="M193 69h40" stroke="var(--bone-dim)" />
  </g></g>
  <path d="M157 112h83m-78 6h73" stroke="var(--bone-dim)" />
  <text x="139" y="152" text-anchor="middle" fill="var(--bone-dim)" stroke="none" font-family="monospace" font-size="7">ROBOTICS / ARTIFICIAL INTELLIGENCE</text>
</svg>}
